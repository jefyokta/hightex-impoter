{
  "name": "@hightex/importer",
  "version": "0.1.0",
  "description": "Side-effect-free HighTex v2 archive parser and validator",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/sync-version.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./tests",
    "prepack": "npm run build",
    "release:version": "npm version --no-git-tag-version",
    "preversion": "npm run typecheck && npm test",
    "version": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "^1.3.14"
  }
}
